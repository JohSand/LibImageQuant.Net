<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- xunit v3, configured for VSTest (xunit.runner.visualstudio + Microsoft.NET.Test.Sdk)
         rather than the newer Microsoft.Testing.Platform-native mode, so `dotnet test` keeps
         working exactly as it did under xunit v2 - no CI changes needed for this part. -->
    <PackageReference Include="FsCheck.Xunit.v3" Version="3.3.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <!-- Pinned to the 3.2.x generation (not the newer 4.0.0) to match what FsCheck.Xunit.v3 and
         Verify.XunitV3 both actually depend on (xunit.v3.extensibility.core 3.2.2) - 4.0.0
         changed an internal API FsCheck.Xunit.v3 relies on, breaking test discovery. -->
    <PackageReference Include="xunit.v3.mtp-off" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Verify.XunitV3" Version="31.28.0" />
    <PackageReference Include="Verify.ImageSharp" Version="5.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LibImageQuant.Net.Codec\LibImageQuant.Net.Codec.csproj" />
    <ProjectReference Include="..\..\src\LibImageQuant.Net.Core\LibImageQuant.Net.Core.csproj" />
    <ProjectReference Include="..\..\src\Zopfli.Net\Zopfli.Net.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="frau-mode-vintage-illustration-1622417428ANN.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="image06.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="panda.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
