<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Description>Managed image quantization for indexed-color PNGs, wrapping the native libimagequant library.</Description>
		<IsWindows Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'true'">true</IsWindows> 
  		<IsOSX Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true'">true</IsOSX> 
  		<IsLinux Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))' == 'true'">true</IsLinux> 
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<!--
	  Native assets are staged by native/build.ps1 (win-x64) and native/build.sh (linux-x64)
	  under native/runtimes/<rid>/native/. Each one is packed to the matching runtimes/<rid>/native
	  path inside the nupkg (the standard NuGet native-asset layout, resolved automatically at
	  restore/run time based on the consumer's RID) and, for local dev/test on this machine,
	  copied to the output directory so the currently-running platform's build/tests keep working.
	  A missing RID (e.g. no Windows build has been run here) is simply skipped, not an error.
	-->
	<ItemGroup>
		<None Include="$(MSBuildThisFileDirectory)/../../native/runtimes/win-x64/native/imagequant.dll"
			  Condition="Exists('$(MSBuildThisFileDirectory)/../../native/runtimes/win-x64/native/imagequant.dll')">
			<Pack>true</Pack>
			<PackagePath>runtimes/win-x64/native/imagequant.dll</PackagePath>
			<Link>imagequant.dll</Link>
			<CopyToOutputDirectory Condition="'$(IsWindows)'=='true'">Always</CopyToOutputDirectory>
		</None>
		<None Include="$(MSBuildThisFileDirectory)/../../native/runtimes/linux-x64/native/libimagequant.so"
			  Condition="Exists('$(MSBuildThisFileDirectory)/../../native/runtimes/linux-x64/native/libimagequant.so')">
			<Pack>true</Pack>
			<PackagePath>runtimes/linux-x64/native/libimagequant.so</PackagePath>
			<Link>libimagequant.so</Link>
			<CopyToOutputDirectory Condition="'$(IsLinux)'=='true'">Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Include="ErrorProne.NET.CoreAnalyzers" Version="0.9.0-beta.4">
	    <PrivateAssets>all</PrivateAssets>
	    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
	  <PackageReference Include="ErrorProne.NET.Structs" Version="0.6.1-beta.1">
	    <PrivateAssets>all</PrivateAssets>
	    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
	</ItemGroup>
</Project>